generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  password          String
  role              Role      @default(STUDENT)
  emailVerified     Boolean   @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  blocked           Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  subscription      Subscription?
  watchProgress     WatchProgress[]
  notificationReads NotificationRead[]

  @@index([email])
}

model Notification {
  id          String    @id @default(cuid())
  title       String
  message     String
  type        String    @default("INFO")
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reads       NotificationRead[]

  @@index([isPublished])
  @@index([publishedAt])
}

model NotificationRead {
  id             String       @id @default(cuid())
  userId         String
  notificationId String
  readAt         DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
  @@index([notificationId])
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id])
  plan            String
  status          SubscriptionStatus @default(ACTIVE)
  startDate       DateTime           @default(now())
  expiryDate      DateTime
  razorpayOrderId   String?
  razorpayPaymentId String?
  couponCode      String?
  discountAmount  Int                @default(0)
  amount          Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiryDate])
}

model SubscriptionPlan {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  description  String?
  price        Int          @default(0)
  durationDays Int          @default(30)
  features     String[]     @default([])
  freeOfferEnabled Boolean   @default(false)
  freeOfferUntil   DateTime?
  isActive     Boolean      @default(true)
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  courses      PlanCourse[]

  @@index([code])
  @@index([isActive])
}

model PlanCourse {
  planId   String
  courseId String
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([planId, courseId])
  @@index([courseId])
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  discountPercent Int
  maxUses       Int      @default(100)
  usedCount     Int      @default(0)
  validFrom     DateTime @default(now())
  validUntil    DateTime
  isActive      Boolean  @default(true)
  applicablePlans String[] @default([])
  createdAt     DateTime @default(now())

  @@index([code])
}

model Course {
  id           String    @id @default(cuid())
  name         String
  description  String?
  vimeoVideoId String?
  tier         String    @default("BASIC")
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  chapters     Chapter[]
  courseChapters CourseChapter[]
  planCourses  PlanCourse[]

  @@index([tier])
}

model CourseChapter {
  courseId  String
  chapterId String
  order     Int    @default(0)

  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([courseId, chapterId])
  @@index([courseId])
  @@index([chapterId])
}

model Chapter {
  id           String    @id @default(cuid())
  name         String
  animationKey String?
  displayOrder Int       @default(0)
  courseId      String?
  course       Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  videos       Video[]
  notes        Note[]
  questions    Question[]
  courseLinks  CourseChapter[]

  @@index([courseId])
}

model Video {
  id           String    @id @default(cuid())
  title        String
  youtubeUrl   String
  videoType    String    @default("ANIMATED_VIDEO")
  language     String    @default("HINDI")
  isFree       Boolean   @default(false)
  displayOrder Int       @default(0)
  chapterId    String
  chapter      Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  watchProgress WatchProgress[]

  @@index([chapterId])
}

model Note {
  id           String    @id @default(cuid())
  title        String
  fileUrl      String
  isFree       Boolean   @default(false)
  displayOrder Int       @default(0)
  chapterId    String
  chapter      Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([chapterId])
}

model Question {
  id           String    @id @default(cuid())
  question     String
  optionA      String
  optionB      String
  optionC      String
  optionD      String
  correctAnswer String
  solution     String?
  displayOrder Int       @default(0)
  chapterId    String
  chapter      Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([chapterId])
}

model WatchProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  videoId     String
  video       Video    @relation(fields: [videoId], references: [id])
  progress    Float    @default(0)
  completed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@index([key])
}
