generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
  TEACHER
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum NotificationTarget {
  ALL
  SUBSCRIBED
  GROUP
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model User {
  id                String         @id @default(cuid())
  name              String
  email             String         @unique
  password          String
  role              Role           @default(STUDENT)
  emailVerified     Boolean        @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  blocked           Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  subscriptions     Subscription[]
  watchProgress     WatchProgress[]
  liveClasses       LiveClass[]        @relation("TeacherLiveClasses")
  liveClassAccess   LiveClassAccess[]
  createdGroups     StudentGroup[]     @relation("CreatedGroups")
  groupMemberships  StudentGroupMember[]

  @@index([email])
  @@index([role])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  plan               String
  classesAccess      String[]           @default([])
  startDate          DateTime           @default(now())
  expiryDate         DateTime
  paymentId          String?
  razorpayOrderId    String?
  razorpaySignature  String?
  status             SubscriptionStatus @default(ACTIVE)
  amount             Int
  couponCode         String?
  discountAmount     Int                @default(0)
  createdAt          DateTime           @default(now())

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiryDate])
  @@index([userId, status, expiryDate])
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int
  maxUses         Int      @default(0)
  usedCount       Int      @default(0)
  validFrom       DateTime @default(now())
  validUntil      DateTime
  active          Boolean  @default(true)
  applicablePlans String[] @default([])
  createdAt       DateTime @default(now())

  @@index([code])
  @@index([active])
}

model Class {
  id       String    @id @default(cuid())
  name     String    @unique
  order    Int       @default(0)

  subjects Subject[]

  @@index([order])
}

model Subject {
  id       String    @id @default(cuid())
  classId  String
  name     String
  icon     String?
  enabled  Boolean   @default(true)

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  chapters    Chapter[]
  boardPapers BoardPaper[]

  @@unique([classId, name])
  @@index([classId])
}

model Course {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  accentColor String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters    CourseChapter[]
}

model CourseChapter {
  courseId  String
  chapterId String
  order     Int    @default(0)

  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([courseId, chapterId])
  @@index([courseId])
  @@index([chapterId])
}

model Chapter {
  id        String     @id @default(cuid())
  subjectId String
  name      String
  order     Int        @default(0)

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  videos    Video[]
  notes     Note[]
  questions Question[]
  courses   CourseChapter[]

  @@index([subjectId])
  @@index([order])
}

model Video {
  id             String          @id @default(cuid())
  chapterId      String
  title          String
  youtubeVideoId String          @default("")
  vimeoVideoId   String?
  language       String          @default("ENGLISH")
  duration       String?
  order          Int             @default(0)
  isFree         Boolean         @default(false)
  type           String          @default("ANIMATED_VIDEO")
  createdAt      DateTime        @default(now())

  chapter        Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  watchProgress  WatchProgress[]

  @@index([chapterId])
  @@index([chapterId, language])
  @@index([chapterId, type])
  @@index([chapterId, language, type])
  @@index([order])
}

model Note {
  id        String   @id @default(cuid())
  chapterId String
  title     String
  pdfUrl    String
  createdAt DateTime @default(now())

  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

model Question {
  id            String   @id @default(cuid())
  chapterId     String
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  solution      String?
  createdAt     DateTime @default(now())

  chapter       Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model WatchProgress {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  progress  Float    @default(0)
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
}

model BoardPaper {
  id        String   @id @default(cuid())
  subjectId String
  year      Int
  title     String
  pdfUrl    String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@unique([subjectId, year, title])
}

model LiveClass {
  id               String             @id @default(cuid())
  title            String
  description      String?
  teacherId        String
  hmsRoomId        String?
  status           LiveClassStatus    @default(SCHEDULED)
  notifyTarget     NotificationTarget @default(ALL)
  scheduledAt      DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  studentGroupId   String?

  teacher          User               @relation("TeacherLiveClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  accessList       LiveClassAccess[]
  studentGroup     StudentGroup?      @relation("GroupLiveClasses", fields: [studentGroupId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@index([studentGroupId])
  @@index([status])
  @@index([scheduledAt])
}

model LiveClassAccess {
  id          String   @id @default(cuid())
  liveClassId String
  userId      String
  createdAt   DateTime @default(now())

  liveClass   LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, userId])
  @@index([liveClassId])
  @@index([userId])
}

model StudentGroup {
  id        String               @id @default(cuid())
  name      String
  createdBy String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  creator     User                 @relation("CreatedGroups", fields: [createdBy], references: [id], onDelete: Cascade)
  members     StudentGroupMember[]
  liveClasses LiveClass[]          @relation("GroupLiveClasses")

  @@index([createdBy])
}

model StudentGroupMember {
  id        String       @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime     @default(now())

  group     StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}
