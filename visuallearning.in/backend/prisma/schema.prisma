generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model User {
  id                String         @id @default(cuid())
  name              String
  email             String         @unique
  phone             String?
  telegramChatId    String?        @unique
  password          String
  role              Role           @default(STUDENT)
  emailVerified     Boolean        @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  blocked           Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  subscriptions     Subscription[]
  watchProgress     WatchProgress[]
  notificationReads NotificationRead[]
  feedback          Feedback[]
  affiliate         Affiliate?

  @@index([email])
  @@index([role])
}

enum AffiliateStatus {
  PENDING
  APPROVED
  BLOCKED
}

// An approved affiliate = a coupon (their code, giving buyers a discount) plus
// commission tracking. Attribution rides on Subscription.couponCode.
model Affiliate {
  id                String          @id @default(cuid())
  userId            String          @unique
  code              String          @unique
  commissionPercent Int?            // null = use the admin default
  status            AffiliateStatus @default(PENDING)
  payoutMethod      String?         // "UPI" | "BANK"
  payoutDetails     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissions       AffiliateCommission[]

  @@index([status])
}

model AffiliateCommission {
  id               String    @id @default(cuid())
  affiliateId      String
  subscriptionId   String    @unique
  userId           String    // the buyer
  saleAmount       Int       // paise
  commissionAmount Int       // paise
  status           String    @default("PENDING") // PENDING | PAID
  createdAt        DateTime  @default(now())
  paidAt           DateTime?

  affiliate        Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String
  type        String   @default("INFO")
  linkUrl     String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reads       NotificationRead[]

  @@index([published, publishedAt])
  @@index([createdAt])
}

model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime     @default(now())

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@index([notificationId])
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  rating    Int?
  message   String
  pageUrl   String?
  isRead    Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([isRead])
  @@index([userId])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  plan               String
  courseId            String?
  classesAccess      String[]           @default([])
  subjectsAccess     String[]           @default([])
  startDate          DateTime           @default(now())
  expiryDate         DateTime
  paymentId          String?
  razorpayOrderId    String?
  razorpaySignature  String?
  status             SubscriptionStatus @default(ACTIVE)
  amount             Int
  couponCode         String?
  discountAmount     Int                @default(0)
  downloadAddon      Boolean            @default(false)
  createdAt          DateTime           @default(now())

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course             Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([expiryDate])
  @@index([userId, status, expiryDate])
  @@index([courseId])
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int
  maxUses         Int      @default(0)
  usedCount       Int      @default(0)
  validFrom       DateTime @default(now())
  validUntil      DateTime
  active          Boolean  @default(true)
  applicablePlans String[] @default([])
  createdAt       DateTime @default(now())

  @@index([code])
  @@index([active])
}

model Class {
  id       String    @id @default(cuid())
  name     String    @unique
  order    Int       @default(0)

  subjects Subject[]

  @@index([order])
}

model Subject {
  id       String    @id @default(cuid())
  classId  String
  name     String
  icon     String?
  enabled  Boolean   @default(true)
  price    Int       @default(0)

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  chapters    Chapter[]
  boardPapers BoardPaper[]

  @@unique([classId, name])
  @@index([classId])
}

model Course {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  accentColor String?
  planKey     String?  @unique
  icon        String?
  vimeoVideoId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters      CourseChapter[]
  subscriptions Subscription[]
}

model CourseChapter {
  courseId  String
  chapterId String
  order     Int    @default(0)

  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([courseId, chapterId])
  @@index([courseId])
  @@index([chapterId])
}

model Chapter {
  id        String     @id @default(cuid())
  subjectId String
  name      String
  order     Int        @default(0)

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  videos    Video[]
  notes     Note[]
  questions Question[]
  courses   CourseChapter[]

  @@index([subjectId])
  @@index([order])
}

model Video {
  id             String          @id @default(cuid())
  chapterId      String
  title          String
  youtubeVideoId String          @default("")
  vimeoVideoId   String?
  language       String          @default("ENGLISH")
  duration       String?
  order          Int             @default(0)
  isFree         Boolean         @default(false)
  type           String          @default("ANIMATED_VIDEO")
  createdAt      DateTime        @default(now())

  chapter        Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  watchProgress  WatchProgress[]

  @@index([chapterId])
  @@index([chapterId, language])
  @@index([chapterId, type])
  @@index([chapterId, language, type])
  @@index([order])
}

model Note {
  id          String   @id @default(cuid())
  chapterId   String
  title       String
  pdfUrl      String
  htmlContent String?
  cssContent  String?
  createdAt   DateTime @default(now())

  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

model Question {
  id            String   @id @default(cuid())
  chapterId     String
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  solution      String?
  createdAt     DateTime @default(now())

  chapter       Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model WatchProgress {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  progress  Float    @default(0)
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
}

model BoardPaper {
  id        String   @id @default(cuid())
  subjectId String
  year      Int
  title     String
  pdfUrl    String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@unique([subjectId, year, title])
}
